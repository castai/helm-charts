{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "castai-storage-autoscaler values",
  "type": "object",
  "properties": {
    "crds": {
      "type": "object",
      "properties": {
        "install": {
          "type": "boolean",
          "description": "Install the chart's CRDs (PVPolicy, PVCMigration). Set to false when the CRDs are already present on the cluster.",
          "default": true
        },
        "keep": {
          "type": "boolean",
          "description": "Annotate the chart's CRDs with helm.sh/resource-policy: keep so helm uninstall leaves them (and any PVPolicy/PVCMigration resources) in place.",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "properties": {
        "performance": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "description": "Which observation to trust: \"max\" or a percentile p50–p99.9 (WOOP annotation format).",
              "pattern": "^(max|p(5[0-9](\\.[0-9])?|[6-8][0-9](\\.[0-9])?|9[0-8](\\.[0-9])?|99(\\.[0-9])?))$"
            },
            "overhead": {
              "type": "number",
              "description": "Buffer on top of the target observation.",
              "minimum": 0,
              "maximum": 2.5
            },
            "lookbackPeriod": {
              "type": "string",
              "description": "How far back to look for cloud performance metrics (Go duration, 1h–24h).",
              "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
            },
            "minWarmupWindow": {
              "type": "string",
              "description": "Minimum warm-up window before acting on performance metrics (Go duration; 0 or 15m–24h).",
              "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
            },
            "changeCooldown": {
              "type": "string",
              "description": "Minimum time between consecutive performance modifications on the same PVC (Go duration, 0–24h).",
              "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
            }
          },
          "additionalProperties": true
        },
        "storage": {
          "type": "object",
          "properties": {
            "thresholdPercent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "growthPercent": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minGrowthStepGiB": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "workerAuth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "token": {
              "type": "string",
              "pattern": "(^$|^.{32,}$)"
            },
            "tokenSecretRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "probeSourceCIDRs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
